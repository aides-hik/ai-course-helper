{
  "manifest_version": 3,
  "name": "AI 网课学习助手",
  "version": "0.9.2",
  "description": "超星、智慧树学习助手，支持 OpenAI / DeepSeek 文字及图片解题、章节诊断和可配置并发。",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "offscreen", "alarms"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html", "default_title": "AI 学习助手"},
  "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; worker-src 'self'"},
  "content_scripts": [
    {
      "matches": ["*://*.chaoxing.com/*", "*://*.edu.cn/*", "*://*.nbdlib.cn/*", "*://*.hnsyu.net/*", "*://*.gdhkmooc.com/*", "*://*.zhihuishu.com/*"],
      "js": ["page-main.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://*.chaoxing.com/*", "*://*.edu.cn/*", "*://*.nbdlib.cn/*", "*://*.hnsyu.net/*", "*://*.gdhkmooc.com/*", "*://*.zhihuishu.com/*"],
      "js": ["vendor/vue.runtime.global.prod.js", "vendor/vue-demi.js", "vendor/element-plus.js", "vendor/pinia.js", "vendor/rxjs.js", "vendor/md5.js", "content.js"],
      "all_frames": false,
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
